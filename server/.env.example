# Local development defaults
# Copy to .env (do not commit .env) and fill values.

# Local Postgres (docker or local install)
POSTGRES_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poses
DB_USER=postgres
# DB_PASSWORD=... (optional; falls back to POSTGRES_PASSWORD)
DB_SSLMODE=disable

# Supabase (production)
# Use the Session pooler host/port and the pooler user shown in Supabase Connect UI.
# DB_HOST=aws-1-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.<your_project_ref>
# DB_PASSWORD=your_supabase_db_password
# DB_SSLMODE=require

# Optional
GEMINI_API_KEY=
SV_LOG_TIMINGS=1
HOST=127.0.0.1
PORT=5000
