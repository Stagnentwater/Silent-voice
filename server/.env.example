# Local development defaults
# Copy to .env (do not commit .env) and fill values.

# Environment switch
# local/dev/development -> uses LOCAL_DATABASE_URL first
# production -> uses DATABASE_URL
ENVIRONMENT=local

# Recommended: URL style
# Local docker pgvector example:
LOCAL_DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/poses

# Production (Supabase)
# DATABASE_URL should include sslmode=require for Supabase
# Example:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Legacy fallback (kept for backward compatibility if DATABASE_URL is empty)
POSTGRES_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poses
DB_USER=postgres
# DB_PASSWORD=... (optional; falls back to POSTGRES_PASSWORD)
DB_SSLMODE=disable

# Optional app settings
GEMINI_API_KEY=
SV_LOG_TIMINGS=1
HOST=127.0.0.1
PORT=5000
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,https://silent-voice-vc1h.vercel.app
